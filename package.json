{
  "name": "ux-developer-companion",
  "displayName": "UX Developer Companion",
  "description": "Circle the bug in your running app and press one key \u2014 Copilot Chat gets the screenshot, the annotation, and the context. Embedded browser with a React/Angular inspector and a11y tools.",
  "version": "0.0.5",
  "publisher": "dlaisoft",
  "license": "MIT",
  "author": {
    "name": "David Lai",
    "email": "david@dlaisoft.com",
    "url": "https://dlai0001.github.io/portfolio"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Testing",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "pricing": "Free",
  "sponsor": {
    "url": "https://github.com/sponsors/dlai0001"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "uxCompanion.open",
        "title": "Open Browser Panel",
        "category": "UX Companion"
      },
      {
        "command": "uxCompanion.sendToPrompt",
        "title": "Send to Chat",
        "category": "UX Companion"
      },
      {
        "command": "uxCompanion.copyCaptureToClipboard",
        "title": "Copy Annotated Screenshot to Clipboard",
        "category": "UX Companion"
      }
    ],
    "configuration": {
      "title": "UX Developer Companion",
      "properties": {
        "uxCompanion.browserPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to Edge/Chrome/Chromium. Leave empty to auto-discover (Edge \u2192 Chrome \u2192 Chromium)."
        },
        "uxCompanion.screencastQuality": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 100,
          "markdownDescription": "JPEG quality for the screencast. Frame rate is never reduced to save bandwidth \u2014 see the idle-pause behaviour instead."
        },
        "uxCompanion.captureDir": {
          "type": "string",
          "default": ".ux-companion/captures",
          "markdownDescription": "Workspace-relative directory for saved screenshots and context text."
        }
      }
    },
    "keybindings": [
      {
        "command": "uxCompanion.sendToPrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeWebviewPanelId == uxCompanion.browserView"
      }
    ]
  },
  "scripts": {
    "build": "npm run prepare:axe && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:ext": "node ./test/extension/runTests.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:ext",
    "fixtures:setup": "node scripts/setup-fixtures.mjs",
    "fixtures:serve": "node scripts/serve-fixtures.mjs",
    "package": "vsce package --out ux-developer-companion.vsix",
    "prepare:axe": "node -e \"require('fs').copyFileSync('node_modules/axe-core/axe.min.js','media/axe.min.js')\""
  },
  "dependencies": {
    "axe-core": "^4.12.1",
    "chrome-remote-interface": "^0.34.0",
    "react-devtools-core": "^6.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "devtools-protocol": "^0.0.1672245",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dlai0001/ux-developer-companion.git"
  },
  "homepage": "https://github.com/dlai0001/ux-developer-companion#readme",
  "bugs": {
    "url": "https://github.com/dlai0001/ux-developer-companion/issues"
  },
  "qna": "https://github.com/dlai0001/ux-developer-companion/issues",
  "keywords": [
    "browser",
    "responsive",
    "accessibility",
    "react",
    "angular",
    "copilot",
    "screenshot",
    "design",
    "annotation",
    "devtools",
    "inspector",
    "ai",
    "ui",
    "frontend"
  ]
}